# OpenAI (face generation via gpt-image-1)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Higgsfield (video generation) — get from cloud.higgsfield.ai/api-keys
HF_API_KEY=your_higgsfield_api_key
HF_API_SECRET=your_higgsfield_api_secret

# Anthropic (caption generation + content director + DM brain)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Image backend: "api" = OpenAI gpt-image-1 (keeper) | "chatgpt" = browser route (superseded) | "livepair" = LivePair i2i (persona-consistent edits, per-result credits)
IMAGE_BACKEND=api

# Video backend: "higgsfield" (default) | "livepair" (i2v — the clip inherits the still's face)
VIDEO_BACKEND=higgsfield

# LivePair — create a key at https://livepairai.com/settings (per-result billing, no subscription)
LP_KEY=
LIVEPAIR_IMAGE_MODEL=qwen-image-3-edit
LIVEPAIR_VIDEO_MODEL=wan-3.0-i2v

# ChatGPT web login (only for the superseded browser route — leave blank if using the API)
CHATGPT_EMAIL=
CHATGPT_PASSWORD=

# X / Twitter (posting)
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
X_BEARER_TOKEN=your_x_bearer_token

# Instagram (posting via instagrapi)
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Pipeline config
NICHE=anime_girl
POSTS_PER_DAY=3
OUTPUT_DIR=assets/output
FACES_DIR=assets/faces
REFERENCES_DIR=assets/references

# Higgsfield (optional overrides)
# Models: dop-turbo (fast), dop-preview (balanced), dop-lite
HIGGSFIELD_MODEL=dop-preview
# Motion style UUID — see cloud.higgsfield.ai for full list of 122 options
HIGGSFIELD_MOTION_ID=c5881721-05b1-47d9-94d6-0203863114e1
HIGGSFIELD_MOTION_STRENGTH=0.8
